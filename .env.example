# =====================================================================
# AI Crypto Trading Bot - Configuration Template
# =====================================================================
# Copy this file to .env and adjust your settings.
# Default mode is PAPER trading (virtual funds) with trading disabled.

# --- Exchange Credentials (Binance) ---
# For Binance Spot Testnet: https://testnet.binance.vision/
BINANCE_API_KEY=Q3dMBf5t7EzGjtu5EqGhlHogEkiBeAjCkDGKUVh5kFbfeNrr4isk3BkwY3b2CtdS
BINANCE_API_SECRET=DsaZw4UMJRDSdblLEXCuTNrlsQUkCX9QoSp3UsSwc7IT9ptppVt0GzzuixtwfgfU
BINANCE_TESTNET=true

# --- Operational Mode & Safety Controls ---
# Available modes: PAPER, TESTNET, LIVE
TRADING_MODE=PAPER

# Global Trading Switch (Must be true for any automated orders to execute)
TRADING_ENABLED=false

# Dual-Confirmation Safeguard for Real Money (Must be explicitly true to enable LIVE mode)
LIVE_TRADING=false

# --- Capital & Portfolio Management ---
STARTING_CAPITAL=50.0
BASE_CURRENCY=USDT
TRADING_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=15m

# --- Database & Storage ---
# SQLite async default. For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/trading_bot
DATABASE_URL=sqlite+aiosqlite:///./data/trading_bot.db

# --- Machine Learning & Feature Engine ---
MODEL_PATH=./models/xgboost_btc_15m.json
FEATURE_SCALER_PATH=./models/scaler_btc_15m.joblib
MIN_PREDICTION_CONFIDENCE=0.65
PREDICTION_HORIZON_CANDLES=4
TARGET_RETURN_THRESHOLD=0.005

# --- Risk Management Controls ---
MAX_RISK_PER_TRADE_PCT=0.01
MAX_POSITION_SIZE_USD=10.0
MAX_DAILY_LOSS_PCT=0.03
MAX_WEEKLY_LOSS_PCT=0.08
MAX_DRAWDOWN_PCT=0.10
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_TRADES=10
DEFAULT_STOP_LOSS_PCT=0.015
DEFAULT_TAKE_PROFIT_PCT=0.030

# --- Server & Monitoring ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
